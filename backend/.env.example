APP_NAME=Tripwise
APP_VERSION=0.1.0
ENVIRONMENT=development

# Active LLM Provider Configuration
# Allowed values: groq, nvidia, gemini, openrouter
LLM_PROVIDER=gemini
LLM_MODEL=

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=

# NVIDIA NIM / Build Configuration
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=

# Optional Fallback Provider & Execution Settings
LLM_FALLBACK_PROVIDER=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
